generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Station {
  id          String   @id @default(uuid()) @map("_id")
  stationCode String   @unique
  name        String
  location    String
  isActive    Boolean  @default(true)
  agentId     String?
  hostname    String?
  platform    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  printers Printer[]
  jobs     PrintJob[]
  files    UploadedFile[]

  @@map("Station")
}

model Printer {
  id            String   @id @default(uuid()) @map("_id")
  name          String
  stationId     String
  printerUri    String
  adapterType   String   @default("WINDOWS")
  isOnline      Boolean  @default(false)
  currentState  String   @default("OFFLINE")
  paperStatus   String   @default("UNKNOWN")
  paperLevel    Int?
  tonerStatus   String   @default("UNKNOWN")
  tonerLevel    Int?
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  station Station   @relation(fields: [stationId], references: [id])
  jobs    PrintJob[]

  @@map("Printer")
}

model PrintJob {
  id                  String   @id @default(cuid()) @map("_id")
  jobId               String   @unique
  stationId           String
  printerId           String?
  fileId              String
  originalFilename    String
  pageCount           Int
  pageRange           String?
  copies              Int      @default(1)
  colorMode           String   @default("BW")
  paperSize           String   @default("A4")
  duplex              Boolean  @default(false)
  price               Int
  currency            String   @default("RWF")
  paymentStatus       String   @default("PENDING")
  authorizationStatus String   @default("PENDING")
  printStatus         String   @default("CREATED")
  errorMessage        String?
  paymentRef          String?
  authorizationToken  String   @unique
  idempotencyKey      String   @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  startedAt           DateTime?
  completedAt         DateTime?

  station Station           @relation(fields: [stationId], references: [id])
  printer Printer?          @relation(fields: [printerId], references: [id])
  file    UploadedFile      @relation(fields: [fileId], references: [id])
  payments PaymentTransaction[]

  @@map("PrintJob")
}

model UploadedFile {
  id               String   @id @default(uuid()) @map("_id")
  originalFilename String
  storedFilename   String
  downloadUrl      String?
  mimeType         String
  fileSize         Int
  pageCount        Int
  checksum         String
  stationId        String
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  station Station   @relation(fields: [stationId], references: [id])
  jobs    PrintJob[]

  @@map("UploadedFile")
}

model PaymentTransaction {
  id        String   @id @default(uuid()) @map("_id")
  jobId     String
  provider  String   @default("MOCK")
  reference String
  amount    Int
  currency  String   @default("RWF")
  status    String   @default("PENDING")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job PrintJob @relation(fields: [jobId], references: [id])

  @@map("PaymentTransaction")
}

model AuditLog {
  id         String   @id @default(uuid()) @map("_id")
  action     String
  entityType String
  entityId   String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("AuditLog")
}

model AdminUser {
  id           String   @id @default(uuid()) @map("_id")
  username     String   @unique
  passwordHash String
  role         String   @default("OPERATOR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("AdminUser")
}

model SystemConfig {
  id        String   @id @default(uuid()) @map("_id")
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("SystemConfig")
}
